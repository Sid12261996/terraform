# Immich environment template
# Upstream reference: https://docs.immich.app/install/environment-variables
# The cloud-init bootstrap writes the real .env on the server; this file is the
# reviewed, pinned copy of what it sets. Keys must match ./docker-compose.yml.

# The location where your uploaded files are stored (block-volume mount)
UPLOAD_LOCATION=/srv/apps/immich/library

# The location where your database files are stored (same block volume)
DB_DATA_LOCATION=/srv/apps/immich/postgres

# To set a timezone, uncomment and change Etc/UTC to a TZ identifier from:
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List
# TZ=Etc/UTC

# The Immich version to use.
# "release" tracks the latest stable release. To pin (recommended once the
# library matters), set a specific version like "v1.xx.x" here AND in
# prod.tfvars (apps_immich.immich_version), then re-run bootstrap + compose up.
IMMICH_VERSION=release

# Connection secret for postgres. The bootstrap auto-generates a random value
# on first boot if left unset/default. Use only characters A-Za-z0-9.
DB_PASSWORD=

# The values below this line do not need to be changed
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
